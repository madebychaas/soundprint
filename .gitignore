# Reference audio may be private or unreleased — never commit it.
# This also covers the world baseline (~610 MB) and the raw dataset archives
# (~2.4 GB): both are build artefacts, rebuildable from documented sources.
/data/
!/data/.gitkeep

# Node
node_modules/
.next/
*.tsbuildinfo
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Generated test audio (regenerate with scripts/make_test_audio.py)
audio-service/tests/fixtures/*.wav

# Local env overrides. web/.env is committed: it only disables Next telemetry.
.env.local
.env.*.local

.DS_Store

# Claude Code local session/tooling state — machine-specific, never shared.
# Previously relied on the operator's global git ignore; explicit here so the
# same protection applies to any clone or contributor.
.claude/
