# Soundprint configuration — copy to web/.env.local and edit as needed.
# Every value has a working default; none of this is required to run Soundprint.

# --- AI interpretation -------------------------------------------------------
# With none of these set, Soundprint uses the Claude CLI if it is installed and
# authenticated, and otherwise falls back to built-in rules (clearly labelled).

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# Point at a local model to keep everything on this machine:
# OPENAI_BASE_URL=http://localhost:11434/v1

# Pin a provider: anthropic | openai | claude-cli | heuristic
# "heuristic" sends nothing over the network at all.
# SOUNDPRINT_LLM_PROVIDER=heuristic

# --- Services ----------------------------------------------------------------
# AUDIO_SERVICE_URL=http://127.0.0.1:8000
# AUDIO_ANALYZE_TIMEOUT_MS=300000
# SOUNDPRINT_DATA_DIR=/absolute/path/to/data
# CLAUDE_CLI_PATH=claude
