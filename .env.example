# Soundprint configuration — copy to web/.env.local and edit as needed.
# Every value has a working default; none of this is required to run Soundprint.
# Never commit a file containing real secrets.

# ---------------------------------------------------------------- AI provider
# With none of these set, Soundprint uses the Claude CLI if it is installed and
# authenticated, and otherwise falls back to built-in rules (clearly labelled).
# Providers read these at call time, so a change takes effect without a restart.

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# Point the base URL at a local model to keep everything on this machine:
# OPENAI_BASE_URL=http://localhost:11434/v1

# Pin a provider: anthropic | openai | claude-cli | heuristic
# "heuristic" sends nothing over the network at all.
# SOUNDPRINT_LLM_PROVIDER=heuristic

# CLAUDE_CLI_PATH=claude

# ------------------------------------------------------------------- services
# AUDIO_SERVICE_URL=http://127.0.0.1:8000
# AUDIO_SERVICE_HOST=127.0.0.1
# AUDIO_SERVICE_PORT=8000
# AUDIO_ANALYZE_TIMEOUT_MS=300000
# SOUNDPRINT_BASE_URL=http://localhost:3000
# SOUNDPRINT_ENV=development
# SOUNDPRINT_LOG_LEVEL=info

# -------------------------------------------------------------------- storage
# All mutable state lives under the data directory. The world baseline is a
# separate file so it can be replaced or shared without touching user data.
# SOUNDPRINT_DATA_DIR=/absolute/path/to/data
# SOUNDPRINT_APP_DB=/absolute/path/to/data/soundprint.db
# SOUNDPRINT_BASELINE_DB=/absolute/path/to/data/baseline/world.db
# SOUNDPRINT_AUDIO_DIR=/absolute/path/to/data/audio

# --------------------------------------------------------------------- limits
# SOUNDPRINT_MAX_UPLOAD_MB=100
# SOUNDPRINT_MAX_DURATION_SECONDS=1800
# SOUNDPRINT_TRANSCODE_TIMEOUT=180

# ----------------------------------------------------------------- transcoder
# ffmpeg is the standard transcoder; afconvert is an optional macOS fallback.
# Set these only if the binaries are somewhere unusual.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# AFCONVERT_PATH=/usr/bin/afconvert

# --------------------------------------------------------------------- docker
# Used by docker-compose.yml only.
# SOUNDPRINT_PORT=3000
